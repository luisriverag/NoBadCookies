{
  "manifest_version": 3,
  "name": "NoBadCookies",
  "version": "1.0.0",
  "description": "Auto-remove cookie banners and manage cookies with ease",
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "scripting",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "web_accessible_resources": [
    {
      "resources": ["interface/popup/approved-suppliers.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/data/background.js"
  },
  "action": {
    "default_popup": "interface/popup/cookie-list.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "interface/sidepanel/cookie-list.html"
  },
  "devtools_page": "interface/devtools/devtool.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["src/data/css/common.css"],
      "js": ["src/data/js/0_defaultClickHandler.js"],
      "run_at": "document_end"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset",
        "enabled": true,
        "path": "src/data/rules.json"
      }
    ]
  },
  "minimum_chrome_version": "88"
}
